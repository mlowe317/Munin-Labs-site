# Server
PORT=3000
DATA_DIR=./data

# --- Email notifications (recommended) ---------------------------------------
# Every demo request and contact message is emailed to NOTIFY_EMAIL.
# Default recipient is lowematthew7@gmail.com; override here if needed.
# NOTIFY_EMAIL=lowematthew7@gmail.com

# Simplest: send through Gmail with an App Password.
# 1. Turn on 2-Step Verification for the Google account.
# 2. Create an App Password at https://myaccount.google.com/apppasswords
# 3. Set the two variables below (spaces in the app password are fine).
# GMAIL_USER=lowematthew7@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Or any other SMTP provider (used only when GMAIL_* is not set).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=your-smtp-password
# SMTP_FROM="Munin Labs Website <lowematthew7@gmail.com>"

# --- Optional webhook (Slack, Zapier, Make, your CRM, ...) ------------------
# NOTIFY_WEBHOOK_URL=https://hooks.example.com/your-endpoint
